 SECTION_RODATA 64
 
+%if ARCH_X86_64
 %macro SMOOTH_WEIGHTS 1-*
 const smooth_weights_1d_16bpc ; sm_weights[] << 7
     %rep %0
@@ -58,8 +59,6 @@ SMOOTH_WEIGHTS   0,   0, 255, 128, 255, 149,  85,  64, \
